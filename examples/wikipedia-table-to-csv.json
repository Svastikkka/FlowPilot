{
  "format": "flowpilot.workflows",
  "schemaVersion": 2,
  "exportedAt": "2026-10-23T00:00:00.000Z",
  "workflows": [
    {
      "schemaVersion": 2,
      "id": "wikipedia-table-to-csv",
      "favorite": false,
      "variables": [],
      "createdAt": 1792713600000,
      "updatedAt": 1792713600000,
      "settings": {
        "defaultTimeoutMs": 15000,
        "defaultRetries": 1,
        "defaultOnError": "stop",
        "stepDelayMs": 0
      },
      "name": "Wikipedia table to CSV",
      "description": "Turns the population table on Wikipedia into rows (country, population, date). Change the URL and cell positions for other tables.",
      "tags": [
        "extraction",
        "tables"
      ],
      "steps": [
        {
          "id": "s1",
          "type": "openUrl",
          "params": {
            "url": "https://en.wikipedia.org/wiki/List_of_countries_and_dependencies_by_population"
          }
        },
        {
          "id": "s7",
          "type": "forEachElement",
          "params": {
            "locator": {
              "strategy": "css",
              "value": "table.wikitable > tbody > tr:has(> td)"
            },
            "loopVariable": "row",
            "maxItems": 300
          },
          "name": "For each table row",
          "children": [
            {
              "id": "s2",
              "type": "extractText",
              "params": {
                "locator": {
                  "strategy": "css",
                  "value": "{{row_selector}} > td:nth-child(1)"
                },
                "variable": "location",
                "all": false
              },
              "name": "Column 1: location"
            },
            {
              "id": "s3",
              "type": "extractText",
              "params": {
                "locator": {
                  "strategy": "css",
                  "value": "{{row_selector}} > td:nth-child(2)"
                },
                "variable": "population",
                "all": false
              },
              "name": "Column 2: population"
            },
            {
              "id": "s4",
              "type": "extractText",
              "params": {
                "locator": {
                  "strategy": "css",
                  "value": "{{row_selector}} > td:nth-child(4)"
                },
                "variable": "asOf",
                "all": false
              },
              "name": "Column 4: date"
            },
            {
              "id": "s5",
              "type": "setVariable",
              "params": {
                "variable": "population",
                "operation": "regexReplace",
                "value": "",
                "pattern": "[^\\d]",
                "replacement": ""
              },
              "name": "Digits only"
            },
            {
              "id": "s6",
              "type": "addRow",
              "params": {
                "columns": [
                  {
                    "name": "location",
                    "value": "{{location}}"
                  },
                  {
                    "name": "population",
                    "value": "{{population}}"
                  },
                  {
                    "name": "as_of",
                    "value": "{{asOf}}"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
